# Copy this file to .env and adjust values for your environment.
# Never commit .env to version control.

# Database connection string (SQLite default for local dev)
DATABASE_URL=sqlite:///./netsentinel.db

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173

# Upload limits (these match the code defaults; override if needed)
# MAX_UPLOAD_BYTES=52428800    # 50 MB
# MAX_UPLOAD_ROWS=500000
